{
  "expo": {
    "name": "Steady",
    "slug": "steady",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "steady",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.steady.app"
    },
    "android": {
      "package": "com.steady.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Steady uses your photos to identify a meal and estimate its calories.",
          "cameraPermission": "Steady uses the camera to photograph a meal and estimate its calories."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
