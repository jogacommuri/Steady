# Steady — Supabase config for Phase 3 sync.
#
# Copy to `.env` and fill in from your Supabase project
# (Dashboard → Project Settings → API). Both are safe to ship in a client:
# the anon key is public and protected by row-level security (supabase/schema.sql).
#
# Expo only exposes variables prefixed with EXPO_PUBLIC_ to the app bundle.
# Leave these unset to run fully offline / local-only.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional: powers the opt-in "estimate calories automatically" toggle on the
# Goals screen (off unless both this key is set AND the toggle is turned on).
# Free key from https://api-ninjas.com — like the Supabase key above, this
# ships inside the client bundle, so treat it as public, not secret.
EXPO_PUBLIC_NUTRITION_API_KEY=YOUR-API-NINJAS-KEY
