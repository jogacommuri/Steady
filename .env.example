# Steady — Supabase config for Phase 3 sync.
#
# Copy to `.env` and fill in from your Supabase project
# (Dashboard → Project Settings → API). Both are safe to ship in a client:
# the anon key is public and protected by row-level security (supabase/schema.sql).
#
# Expo only exposes variables prefixed with EXPO_PUBLIC_ to the app bundle.
# Leave these unset to run fully offline / local-only.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# The opt-in "estimate calories automatically" toggle on the Goals screen
# needs no client-side key — it calls a Supabase Edge Function
# (supabase/functions/estimate-calories) that proxies to Claude. The real
# Anthropic key is a Supabase secret, set once via the CLI, never in this
# file and never shipped in the app bundle:
#
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   supabase functions deploy estimate-calories
#
# See docs/supabase-setup.md.
